FROM rust:1-bookworm AS builder

ARG TRUNK_VERSION=0.21.14
ARG BINARYEN_VERSION=129

ENV SQLX_OFFLINE=true

RUN rustup toolchain install stable --profile minimal --target wasm32-unknown-unknown \
    && curl -fsSL "https://github.com/trunk-rs/trunk/releases/download/v${TRUNK_VERSION}/trunk-x86_64-unknown-linux-gnu.tar.gz" \
       | tar -xz -C /usr/local/bin \
    && curl -fsSL "https://github.com/WebAssembly/binaryen/releases/download/version_${BINARYEN_VERSION}/binaryen-version_${BINARYEN_VERSION}-x86_64-linux.tar.gz" \
       | tar -xz -C /tmp \
    && mv "/tmp/binaryen-version_${BINARYEN_VERSION}/bin/wasm-opt" /usr/local/bin/ \
    && rm -rf /tmp/binaryen-*

WORKDIR /src
COPY . .

RUN cd crates/rustmail_panel \
    && trunk build --release --dist ../rustmail/static --config Trunk.toml

RUN cargo build --release -p rustmail \
    && cp target/release/rustmail /rustmail


FROM debian:bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /rustmail /app/rustmail

RUN mkdir -p /app/db \
    && useradd -m -u 1000 rustmail \
    && chown -R rustmail:rustmail /app

USER rustmail

EXPOSE 3002

VOLUME ["/app/db"]

ENTRYPOINT ["/app/rustmail"]